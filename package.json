{
  "homepage": ".",
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "preact": "^11.1.1",
    "tailwind-merge": "^3.6.0",
    "wouter-preact": "^3.13.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "dev:mock": "node scripts/dev-with-mocks.js",
    "mock:server": "node mock-server/server.js",
    "build": "vite build",
    "build:mock": "node scripts/react-scripts-with-mocks.js build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm run build && gh-pages -d build",
