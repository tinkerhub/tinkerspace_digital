    "supabase:stop": "supabase stop",
    "supabase:push": "supabase db push"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "only-allow": "^1.2.2",
    "postcss": "^8.4.49",
    "supabase": "^2.117.0",
